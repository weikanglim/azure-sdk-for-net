#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
local_bin="$HOME/.local/bin"
dotnet_dir="$HOME/.dotnet"
node_version="22.18.0"
powershell_version="7.5.2"

mkdir -p "$local_bin" "$dotnet_dir"
export PATH="$local_bin:$dotnet_dir/tools:$PATH"
export DOTNET_ROOT="$dotnet_dir"

run_step() {
  local description="$1"
  shift
  echo "==> $description"
  time "$@"
}

install_dotnet() (
  if "$dotnet_dir/dotnet" --list-sdks 2>/dev/null | grep -q '^10\.0\.400 '; then
    echo ".NET SDK 10.0.400 is already installed"
    return
  fi

  local installer
  installer="$(mktemp)"
  trap 'rm -f "$installer"' EXIT
  curl --fail --location --retry 3 --silent --show-error \
    https://dot.net/v1/dotnet-install.sh --output "$installer"
  bash "$installer" --version 10.0.400 --install-dir "$dotnet_dir" --no-path
)

install_node() (
  local architecture node_arch install_dir archive
  architecture="$(uname -m)"
  case "$architecture" in
    x86_64) node_arch="x64" ;;
    aarch64|arm64) node_arch="arm64" ;;
    *) echo "Unsupported Node.js architecture: $architecture" >&2; return 1 ;;
  esac

  install_dir="$HOME/.local/lib/node-v${node_version}-linux-${node_arch}"
  if [[ ! -x "$install_dir/bin/node" ]]; then
    archive="$(mktemp)"
    trap 'rm -f "$archive"' EXIT
    curl --fail --location --retry 3 --silent --show-error \
      "https://nodejs.org/dist/v${node_version}/node-v${node_version}-linux-${node_arch}.tar.xz" \
      --output "$archive"
    mkdir -p "$HOME/.local/lib"
    rm -rf "$install_dir"
    tar -xJf "$archive" -C "$HOME/.local/lib"
  else
    echo "Node.js $node_version is already installed"
  fi

  ln -sfn "$install_dir/bin/node" "$local_bin/node"
  ln -sfn "$install_dir/bin/npm" "$local_bin/npm"
  ln -sfn "$install_dir/bin/npx" "$local_bin/npx"
  ln -sfn "$install_dir/bin/corepack" "$local_bin/corepack"
)

install_powershell() (
  local architecture powershell_arch install_dir archive
  architecture="$(uname -m)"
  case "$architecture" in
    x86_64) powershell_arch="x64" ;;
    aarch64|arm64) powershell_arch="arm64" ;;
    *) echo "Unsupported PowerShell architecture: $architecture" >&2; return 1 ;;
  esac

  install_dir="$HOME/.local/lib/powershell-$powershell_version"
  if [[ ! -x "$install_dir/pwsh" ]]; then
    archive="$(mktemp)"
    trap 'rm -f "$archive"' EXIT
    curl --fail --location --retry 3 --silent --show-error \
      "https://github.com/PowerShell/PowerShell/releases/download/v${powershell_version}/powershell-${powershell_version}-linux-${powershell_arch}.tar.gz" \
      --output "$archive"
    rm -rf "$install_dir"
    mkdir -p "$install_dir"
    tar -xzf "$archive" -C "$install_dir"
    chmod +x "$install_dir/pwsh"
  else
    echo "PowerShell $powershell_version is already installed"
  fi

  ln -sfn "$install_dir/pwsh" "$local_bin/pwsh"
)

configure_login_shell() {
  local marker="# azure-sdk-for-net orb toolchains"
  touch "$HOME/.bash_profile"
  if ! grep -Fqx "$marker" "$HOME/.bash_profile"; then
    cat >> "$HOME/.bash_profile" <<'EOF'

# azure-sdk-for-net orb toolchains
export DOTNET_ROOT="$HOME/.dotnet"
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
case ":$PATH:" in
  *":$HOME/.dotnet/tools:"*) ;;
  *) export PATH="$HOME/.dotnet/tools:$PATH" ;;
esac
EOF
  fi
}

run_step "Install .NET SDK" install_dotnet
ln -sfn "$dotnet_dir/dotnet" "$local_bin/dotnet"
run_step "Install Node.js" install_node
run_step "Install PowerShell" install_powershell
run_step "Configure login shells" configure_login_shell
run_step "Restore root Node.js dependencies" npm ci --ignore-scripts=false --prefix "$repo_root"

echo "==> Toolchain versions"
dotnet --version
node --version
npm --version
pwsh -NoLogo -NoProfile -Command '$PSVersionTable.PSVersion.ToString()'
